# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
build/
dist/

# Secrets: only .env.example is committed
.env
.env.*
!.env.example

# Pricing run outputs (reports, results, manifests). The audit log of every run is
# kept, but the bulky per-run folders are regenerated from committed inputs.
runs/*
!runs/.gitkeep
!runs/audit_log.jsonl

# Operational data (quote audit log etc.) and large re-fetchable research inputs
var/
data/raw/research/chirps_monthly_eastern_kenya.nc
data/raw/research/chirps_monthly_eastern_kenya.npz
# CHIRPS v3 per-year windows kept only so an interrupted fetch can resume
data/raw/chirps3/_partial/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Overnight QA artefacts: screenshots stay local (large); summaries and JSON are committed
docs/overnight/before/
docs/overnight/after/
docs/overnight/*/
tools/qa/node_modules/

# Personal Claude Code settings
.claude/settings.local.json
