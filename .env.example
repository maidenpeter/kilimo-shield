# AgroShield environment template. Copy to .env and fill in; .env is never committed.
# Nothing here is needed for the pricing engine and reports.

# --- Rainfall data ---
# ClimateSERV (SERVIR) needs no key. Override only if pointing at a mirror.
# CLIMATESERV_BASE_URL=https://climateserv.servirglobal.net/api

# --- Later milestones (placeholders, not used yet) ---
# DATABASE_URL=postgresql://agroshield:change-me@localhost:5432/agroshield

# --- SACCO portal (milestone 5) ---
# Required for any shared deployment. Each is 32 random bytes, base64-encoded:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# If unset, development keys are generated into var/dev-keys.json (git-ignored).
# Losing NATIONAL_ID_ENCRYPTION_KEY makes stored IDs and phones unreadable: keep it in a secrets manager.
# NATIONAL_ID_ENCRYPTION_KEY=   # AES-256-GCM key for national IDs and phone numbers at rest
# LOOKUP_HMAC_KEY=              # HMAC key for searchable hashes of IDs and phones
# SESSION_SECRET=               # signs portal session cookies
# DATABASE_URL=sqlite:///var/agroshield.db   # default; PostgreSQL in deployment (above)
# AGROSHIELD_OFFICER_PASSWORD=  # read by `agroshield-portal add-officer` instead of a prompt
# CALLBACK_TOKEN=               # random URL-safe secret; the USSD and M-Pesa callback URLs end in it
#   python -c "import secrets;print(secrets.token_urlsafe(24))"

# --- M-Pesa (milestone 6) ---
# MPESA_ENV=simulated           # simulated (default, no network) | sandbox | production
# MPESA_CONSUMER_KEY=           # from your Daraja app (developer.safaricom.co.ke)
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379        # Daraja sandbox shortcode
# MPESA_PASSKEY=                # sandbox passkey from the Daraja portal
# MPESA_CALLBACK_BASE_URL=      # public https base URL Safaricom can reach, e.g. an https tunnel
# MPESA_CONFIRM_WITH_QUERY=true # re-check every callback with an STK query before crediting

# --- SMS and USSD (Africa's Talking, milestone 6) ---
# SMS_MODE=log                  # log (default: recorded, not sent) | sandbox | live
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=     # optional alphanumeric sender ID, once approved
# USSD_SERVICE_CODE=*384*000#   # placeholder; your Africa's Talking USSD code

# --- Photo rider (milestone 8) ---
# ANTHROPIC_API_KEY=            # assists human photo reviewers; never used for payouts or pricing
